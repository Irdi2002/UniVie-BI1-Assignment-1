  <worksheets>
    <worksheet name='Q1 - Ranking Accuracy'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#1e3a5f' fontname='Calibri' fontsize='14'>How well do rankings predict outcomes across tournament types?</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='fact_match+' name='federated.1rz59df1o5t2bj1a3zqxi0pxi06c' />
          </datasources>
          <datasource-dependencies datasource='federated.1rz59df1o5t2bj1a3zqxi0pxi06c'>
            <column caption='Ranking Accuracy' datatype='real' default-format='p0.0%' name='[Calculation_0516495863091203]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [ranking_was_correct] = TRUE THEN 1 ELSEIF [ranking_was_correct] = FALSE THEN 0 END)&#13;&#10;/&#13;&#10;SUM(IF [ranking_was_correct] = TRUE OR [ranking_was_correct] = FALSE THEN 1 END)' />
            </column>
            <column-instance column='[tournament_category]' derivation='None' name='[none:tournament_category:nk]' pivot='key' type='nominal' />
