    <worksheet name='Q4 - Does Ranking Gap Predict Outcomes'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#1e3a5f' fontname='Calibri' fontsize='14'>When are rankings reliable, and when do they fail?</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='14'>Æ </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='fact_match+' name='federated.1rz59df1o5t2bj1a3zqxi0pxi06c' />
          </datasources>
          <datasource-dependencies datasource='federated.1rz59df1o5t2bj1a3zqxi0pxi06c'>
            <column caption='Ranking Accuracy' datatype='real' default-format='p0.0%' name='[Calculation_0516495863091203]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [ranking_was_correct] = TRUE THEN 1 ELSEIF [ranking_was_correct] = FALSE THEN 0 END)&#13;&#10;/&#13;&#10;SUM(IF [ranking_was_correct] = TRUE OR [ranking_was_correct] = FALSE THEN 1 END)' />
            </column>
            <column caption='Ranking Gap Bucket' datatype='string' name='[Calculation_0516495874514952]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ABS([rank_gap]) &lt;= 5 THEN &quot;1. Very close (≤5)&quot;&#13;&#10;ELSEIF ABS([rank_gap]) &lt;= 15 THEN &quot;2. Close (6-15)&quot;&#13;&#10;ELSEIF ABS([rank_gap]) &lt;= 30 THEN &quot;3. Moderate (16-30)&quot;&#13;&#10;ELSEIF ABS([rank_gap]) &lt;= 60 THEN &quot;4. Wide (31-60)&quot;&#13;&#10;ELSE &quot;5. Mismatch (&gt;60)&quot;&#13;&#10;END' />
            </column>
            <column caption='Both Top 20' datatype='string' name='[Calculation_0516495874633737]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [home_rank] &lt;= 20 AND [away_rank] &lt;= 20 THEN &quot;Both top 20&quot;&#13;&#10;ELSEIF [home_rank] &lt;= 20 OR [away_rank] &lt;= 20 THEN &quot;One top 20&quot;&#13;&#10;ELSE &quot;Neither top 20&quot;&#13;&#10;END' />
            </column>
            <column caption='Away Rank' datatype='real' name='[away_rank]' role='measure' type='quantitative' />
            <column caption='Home Rank' datatype='real' name='[home_rank]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0516495874514952]' derivation='None' name='[none:Calculation_0516495874514952:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0516495874633737]' derivation='None' name='[none:Calculation_0516495874633737:nk]' pivot='key' type='nominal' />
            <column caption='Rank Gap' datatype='real' name='[rank_gap]' role='measure' type='quantitative' />
            <column caption='Ranking Was Correct' datatype='boolean' name='[ranking_was_correct]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_0516495863091203]' derivation='User' name='[usr:Calculation_0516495863091203:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='quantitative' column='[federated.1rz59df1o5t2bj1a3zqxi0pxi06c].[usr:Calculation_0516495863091203:qk]' included-values='non-null' />
          <slices>
            <column>[federated.1rz59df1o5t2bj1a3zqxi0pxi06c].[usr:Calculation_0516495863091203:qk]</column>
          </slices>
          <aggregation value='true' />
        </view>
