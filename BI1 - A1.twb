      <aliases enabled='yes' />
      <column caption='Match Count' datatype='integer' name='[Calculation_0516495862824961]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([match_key])' />
      </column>
      <column caption='Has Both Rankings' datatype='boolean' name='[Calculation_0516495862968322]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='NOT ISNULL([home_rank]) AND NOT ISNULL([away_rank])' />
      </column>
      <column caption='Ranking Accuracy' datatype='real' default-format='p0.0%' name='[Calculation_0516495863091203]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [ranking_was_correct] = TRUE THEN 1 ELSEIF [ranking_was_correct] = FALSE THEN 0 END)&#13;&#10;/&#13;&#10;SUM(IF [ranking_was_correct] = TRUE OR [ranking_was_correct] = FALSE THEN 1 END)' />
      </column>
      <column caption='Home Win' datatype='integer' name='[Calculation_0516495863169028]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [actual_winner] = &quot;home&quot; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Home Win Rate' datatype='real' default-format='p0.0%' name='[Calculation_0516495863250949]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_0516495863169028])' />
      </column>
      <column caption='Performance vs Ranking' datatype='real' default-format='p0.0%' name='[Calculation_0516495868760071]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;  IF [Calculation_0516495862968322] THEN&#13;&#10;    IF [actual_winner] = &quot;home&quot; THEN 1.0&#13;&#10;    ELSEIF [actual_winner] = &quot;draw&quot; THEN 0.5&#13;&#10;    ELSE 0.0&#13;&#10;    END&#13;&#10;  END&#13;&#10;) / SUM(IF [Calculation_0516495862968322] THEN 1 END)&#13;&#10;-&#13;&#10;SUM(&#13;&#10;  IF [Calculation_0516495862968322] THEN&#13;&#10;    IF [ranking_predicted_winner] = &quot;home&quot; THEN 1.0&#13;&#10;    ELSEIF [ranking_predicted_winner] = &quot;tie&quot; THEN 0.5&#13;&#10;    ELSE 0.0&#13;&#10;    END&#13;&#10;  END&#13;&#10;) / SUM(IF [Calculation_0516495862968322] THEN 1 END)' />
      </column>
      <column caption='Ranking Gap Bucket' datatype='string' name='[Calculation_0516495874514952]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ABS([rank_gap]) &lt;= 5 THEN &quot;1. Very close (≤5)&quot;&#13;&#10;ELSEIF ABS([rank_gap]) &lt;= 15 THEN &quot;2. Close (6-15)&quot;&#13;&#10;ELSEIF ABS([rank_gap]) &lt;= 30 THEN &quot;3. Moderate (16-30)&quot;&#13;&#10;ELSEIF ABS([rank_gap]) &lt;= 60 THEN &quot;4. Wide (31-60)&quot;&#13;&#10;ELSE &quot;5. Mismatch (&gt;60)&quot;&#13;&#10;END' />
      </column>
      <column caption='Both Top 20' datatype='string' name='[Calculation_0516495874633737]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [home_rank] &lt;= 20 AND [away_rank] &lt;= 20 THEN &quot;Both top 20&quot;&#13;&#10;ELSEIF [home_rank] &lt;= 20 OR [away_rank] &lt;= 20 THEN &quot;One top 20&quot;&#13;&#10;ELSE &quot;Neither top 20&quot;&#13;&#10;END' />
      </column>
