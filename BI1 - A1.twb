    <worksheet name='Q3 - Confederation Heatmap'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#1e3a5f' fontname='Calibri' fontsize='14'>Which confederations beat or underperform their ranking?</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='14'>Æ </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='fact_match+' name='federated.1rz59df1o5t2bj1a3zqxi0pxi06c' />
          </datasources>
          <datasource-dependencies datasource='federated.1rz59df1o5t2bj1a3zqxi0pxi06c'>
            <column caption='Match Count' datatype='integer' name='[Calculation_0516495862824961]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([match_key])' />
            </column>
            <column caption='Has Both Rankings' datatype='boolean' name='[Calculation_0516495862968322]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT ISNULL([home_rank]) AND NOT ISNULL([away_rank])' />
            </column>
            <column caption='Performance vs Ranking' datatype='real' default-format='p0.0%' name='[Calculation_0516495868760071]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;  IF [Calculation_0516495862968322] THEN&#13;&#10;    IF [actual_winner] = &quot;home&quot; THEN 1.0&#13;&#10;    ELSEIF [actual_winner] = &quot;draw&quot; THEN 0.5&#13;&#10;    ELSE 0.0&#13;&#10;    END&#13;&#10;  END&#13;&#10;) / SUM(IF [Calculation_0516495862968322] THEN 1 END)&#13;&#10;-&#13;&#10;SUM(&#13;&#10;  IF [Calculation_0516495862968322] THEN&#13;&#10;    IF [ranking_predicted_winner] = &quot;home&quot; THEN 1.0&#13;&#10;    ELSEIF [ranking_predicted_winner] = &quot;tie&quot; THEN 0.5&#13;&#10;    ELSE 0.0&#13;&#10;    END&#13;&#10;  END&#13;&#10;) / SUM(IF [Calculation_0516495862968322] THEN 1 END)' />
            </column>
            <column caption='Actual Winner' datatype='string' name='[actual_winner]' role='dimension' type='nominal' />
            <column caption='Away Rank' datatype='real' name='[away_rank]' role='measure' type='quantitative' />
            <column caption='Confederation (Dim Country.Csv1)' datatype='string' name='[confederation (dim_country.csv1)]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Confederation' datatype='string' name='[confederation]' role='dimension' type='nominal' />
            <column caption='Home Rank' datatype='real' name='[home_rank]' role='measure' type='quantitative' />
            <column caption='Match Key' datatype='integer' name='[match_key]' role='dimension' type='ordinal' />
